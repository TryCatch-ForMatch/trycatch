generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  BUSCANDO
  EM_ANDAMENTO
  CONCLUIDO
}

enum UserRole {
  ADMIN
  USER
  MENTOR
}

enum RoleRequest {
  USER
  MENTOR
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                String             @id @default(cuid())
  name              String
  userName          String?            @unique
  email             String             @unique
  createdAt         DateTime           @default(now())
  avatar            String?
  github            String?
  linkedin          String?
  password          String
  updatedAt         DateTime           @updatedAt
  bio               String?
  isActive          Boolean            @default(true)
  role              UserRole           @default(USER)  
  feedbacksGiven    Feedback[]         @relation("FeedbackGiver")
  feedbacksReceived Feedback[]         @relation("FeedbackReceiver")
  projects          Project[]          @relation("ProjectOwner")
  stacksTaken       StackTaken[]
  availability      UserAvailability[]
  certificates      UserCertificate[]
  skills            UserSkill[]

  showEmail         Boolean             @default(false)
  showGithub        Boolean             @default(true)
  showLinkedin      Boolean             @default(true)
  showCertificates  Boolean             @default(true)
  showProjects      Boolean             @default(true)
  showFeedback      Boolean             @default(false)
  portfolioPublic   Boolean             @default(true)
}

model Skill {
  id        String         @id @default(cuid())
  name      String         @unique  
  iconUrl   String?
  projects  ProjectSkill[]
  users     UserSkill[]
  
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  
}

model Stack {
  id          String         @id @default(cuid())
  name        String         @unique
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  projects    ProjectStack[]
  stacksTaken StackTaken[]   @relation("StackStacksTaken")
}

model Project {
  id          String         @id @default(cuid())
  ownerId     String
  name        String
  description String
  deadline    DateTime
  totalValue  Float
  status      ProjectStatus
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  feedbacks   Feedback[]
  owner       User           @relation("ProjectOwner", fields: [ownerId], references: [id])
  skills      ProjectSkill[]
  stacks      ProjectStack[]
  stacksTaken StackTaken[]   @relation("ProjectStacksTaken")
  github      String?
}

model ProjectStack {
  id         String       @id @default(cuid())
  projectId  String
  stackId    String
  percentage Float
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  project    Project      @relation(fields: [projectId], references: [id])
  stack      Stack        @relation(fields: [stackId], references: [id])
  StackTaken StackTaken[]
}

model StackTaken {
  id             String       @id @default(cuid())
  projectStackId String
  userId         String
  stackId        String
  projectId      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  feedbacks      Feedback[]
  project        Project      @relation("ProjectStacksTaken", fields: [projectId], references: [id])
  projectStack   ProjectStack @relation(fields: [projectStackId], references: [id])
  stack          Stack        @relation("StackStacksTaken", fields: [stackId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
}

model UserSkill {
  id        String   @id @default(cuid())
  userId    String
  skillId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  skill     Skill    @relation(fields: [skillId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model ProjectSkill {
  id        String   @id @default(cuid())
  projectId String
  skillId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id])
  skill     Skill    @relation(fields: [skillId], references: [id])
}

model Feedback {
  id           String      @id @default(cuid())
  projectId    String
  fromUserId   String
  toUserId     String
  rating       Int
  comment      String?
  anonymous    Boolean
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  stackTakenId String?
  fromUser     User        @relation("FeedbackGiver", fields: [fromUserId], references: [id])
  project      Project     @relation(fields: [projectId], references: [id])
  stackTaken   StackTaken? @relation(fields: [stackTakenId], references: [id])
  toUser       User        @relation("FeedbackReceiver", fields: [toUserId], references: [id])
}

model Invite {
  id        String    @id @default(cuid())
  email     String
  code      String
  used      Boolean   @default(false)
  invitedBy String?
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  role      UserRole
}

model UserAvailability {
  id        String   @id @default(cuid())
  userId    String
  weekday   Int
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, weekday])
}

model UserCertificate {
  id          String   @id @default(cuid())
  userId      String
  title       String
  url         String?
  issuer      String
  date        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model InviteRequest {
  id        String        @id @default(cuid())
  name      String
  email     String        @unique
  linkedin  String
  role      RoleRequest   @default(USER)
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())
}
